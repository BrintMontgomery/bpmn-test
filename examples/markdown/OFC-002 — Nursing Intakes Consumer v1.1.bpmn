<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OFC-002_NursingIntakesConsumer" targetNamespace="http://oklahoma.gov/odmhsas/ofc/bpmn" exporter="ir.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_OFC-002_NursingIntakesConsumer">
    <bpmn:participant id="Participant_OFC-002_NursingIntakesConsumer" name="Oklahoma Forensic Center" processRef="OFC-002_NursingIntakesConsumer"/>
  </bpmn:collaboration>
  <bpmn:process id="OFC-002_NursingIntakesConsumer" name="OFC-002 Nursing Intakes Consumer" isExecutable="false">
    <bpmn:documentation>- Models the extracted nursing-admission workflow from scheduled notification through documentation quality review and handoff of unresolved issues. Main-path task ownership follows the first bold actor; later bold actors are represented as counterparties in task names unless the extraction gives them a distinct task. Where a main-path step states that either actor may act, the first listed actor owns one task and the alternate actor remains explicit in the task name. Option entry and rejoin locations are modeling judgments where the extraction does not identify an exact point: changed and rush admissions are placed before preparation; simultaneous and after-hours admissions before nursing begins; medical, behavioral, and same-sex staffing exceptions during the initial nursing portion; participation during the first consumer interview; medication-history exception at reconciliation; and consent refusal at signing. Option C ends the routine process when disposition is outside OFC, and Option E ends the routine path when a separate legal or clinical barrier exists, because the extraction gives no continuation path for either condition.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_OFC-002_NursingIntakesConsumer">
      <bpmn:lane id="Lane_AdmissionsCoordinator" name="Admissions Coordinator">
        <bpmn:flowNodeRef>StartEvent_ScheduledAdmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAdmissionEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChangedAdmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_I_DistributeUpdatedInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_CoordinateAdmissionStatus</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MedicalRecords" name="Medical Records Staff">
        <bpmn:flowNodeRef>Task_SendAvailableRecords</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="Security Officer">
        <bpmn:flowNodeRef>Task_SecurityReportsReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MultipleConsumers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_H_MaintainWaitingConsumers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_AdjustPrecautions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscortToUnit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UnitNurse" name="Unit Nurse">
        <bpmn:flowNodeRef>Task_I_DoNotUseEarlierPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_I_PrintOrUpdatePack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RushAdmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G_UsePreprintedPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_G_ConfirmCurrentInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintNursingAdmitPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestMHT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_H_ProcessEachConsumer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AfterHours</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_FollowStandardProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_CoordinateAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_CompleteDuringShift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeginNursingAdmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MedicalException</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_AssessMedicalCondition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_InformPhysician</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_C_MedicalDisposition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AggressiveUnsafe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_AssessSafetyConcern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_ContactPhysician</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_B_AdditionalPrecautions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_InformSecurity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_ConfirmRoutineCanContinue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SameSexStaffing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A_ConfirmFemaleStaff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_A_FemaleSecurityAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A_MaintainSameSexSupervision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LiceCheckTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeginBiophysicalAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CannotParticipate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_F_CompleteSafeActivities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_F_DocumentCooperation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_F_LeaveUnavailableInfoUnresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_F_ReturnToUnresolvedItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_F_ContinueNonvoluntaryActivities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveConsumerAndVitals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateBiophysicalAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteTraumaAndSuicideAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteSafeTSteps1And2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactPhysicianForEncounter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MedicationHistoryUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_InformPhysician</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_UpdateReconciliation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteMedicationReconciliation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferConsentDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_E_ExplainAndOfferConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_E_RecordRefusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_E_SeparateBarrier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_E_ContinueAdmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_E_SeparateResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollateAdmissionRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDocumentsForCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RouteMedicationInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RouteNutritionalScreening</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FilePaperAdmissionDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterAdmissionIntoAvatar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteAvatarIPGeneralNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteAvatarNursingAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteAvatarTraumaAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteAvatarFallAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteAvatarDailyFunctioning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyAdmissionCompletion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommunicateUnresolvedIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NursingAdmissionComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ChargeAide" name="Charge Aide"/>
      <bpmn:lane id="Lane_MHT" name="Mental Health Technician (MHT)">
        <bpmn:flowNodeRef>Task_H_AdjustMHTAssignments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A_FemaleMHTAssists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssistShower</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrientConsumerToUnit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveInformationalMaterials</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consumer" name="Consumer">
        <bpmn:flowNodeRef>Task_ConsumerCompletesShower</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConsentRefusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_E_SignsAfterExplanation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_E_ConsumerRefusesConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsumerSignsConsent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SocialWorker" name="Social Worker">
        <bpmn:flowNodeRef>Task_D_ContactOriginatingJail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Physician" name="Physician">
        <bpmn:flowNodeRef>Gateway_C_SafeAtOFC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_DirectEmergencyOrDiversion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_B_ImmediateIntervention</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicianInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicianPaperworkAndSafeT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_D_AdditionalInformationRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PsychoactiveMedication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewPsychoactiveConsent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HIC" name="Health Information Coordinator">
        <bpmn:flowNodeRef>Task_AuditDocumentation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pharmacy" name="Pharmacy Staff">
        <bpmn:flowNodeRef>Task_PharmacyReceivesInformation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dietary" name="Dietary Manager">
        <bpmn:flowNodeRef>Task_DietaryReceivesScreening</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OriginatingJail" name="Originating Jail Staff">
        <bpmn:flowNodeRef>Task_D_ProvideMedicationInformation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LegalCounsel" name="Legal Counsel">
        <bpmn:flowNodeRef>Gateway_C_LegalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_LegalReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ScheduledAdmission" name="Scheduled nursing admission is planned">
      <bpmn:outgoing>Flow_StartEvent_ScheduledAdmission__Task_SendAdmissionEmail</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_StartEvent_ScheduledAdmission"/>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_SendAdmissionEmail" name="Send scheduled admission email">
      <bpmn:incoming>Flow_StartEvent_ScheduledAdmission__Task_SendAdmissionEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SendAdmissionEmail__Task_SendAvailableRecords</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_SendAvailableRecords" name="Send available Avatar-number and prior-admission information to Nursing">
      <bpmn:incoming>Flow_Task_SendAdmissionEmail__Task_SendAvailableRecords</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SendAvailableRecords__Gateway_ChangedAdmission</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_ChangedAdmission" name="Admission information changed or rescheduled?" default="Flow_Gateway_ChangedAdmission__Gateway_RushAdmission">
      <bpmn:documentation>- Option I — the planned date, arrival time, unit, Physician, or other admission information changes after initial notification.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_SendAvailableRecords__Gateway_ChangedAdmission</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ChangedAdmission__Gateway_RushAdmission</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_ChangedAdmission__Task_I_DistributeUpdatedInformation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_I_DistributeUpdatedInformation" name="Distribute updated admission information">
      <bpmn:incoming>Flow_Gateway_ChangedAdmission__Task_I_DistributeUpdatedInformation</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_I_DistributeUpdatedInformation__Task_I_DoNotUseEarlierPack</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_I_DoNotUseEarlierPack" name="Do not rely on a Nursing Admit Pack printed for an earlier date">
      <bpmn:incoming>Flow_Task_I_DistributeUpdatedInformation__Task_I_DoNotUseEarlierPack</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_I_DoNotUseEarlierPack__Task_I_PrintOrUpdatePack</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_I_PrintOrUpdatePack" name="Print or update the Nursing Admit Pack for the confirmed admission day">
      <bpmn:incoming>Flow_Task_I_DoNotUseEarlierPack__Task_I_PrintOrUpdatePack</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_I_PrintOrUpdatePack__Gateway_RushAdmission</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_RushAdmission" name="Substantially less advance notice than usual?" default="Flow_Gateway_RushAdmission__Task_PrintNursingAdmitPack">
      <bpmn:documentation>- Option G — OFC knows the Consumer is expected but receives substantially less advance notice than usual.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_ChangedAdmission__Gateway_RushAdmission</bpmn:incoming>
      <bpmn:incoming>Flow_Task_I_PrintOrUpdatePack__Gateway_RushAdmission</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_RushAdmission__Task_PrintNursingAdmitPack</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_RushAdmission__Task_G_UsePreprintedPack</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_G_UsePreprintedPack" name="Use an available preprinted admission packet when necessary">
      <bpmn:incoming>Flow_Gateway_RushAdmission__Task_G_UsePreprintedPack</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_G_UsePreprintedPack__Task_G_ConfirmCurrentInformation</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_G_ConfirmCurrentInformation" name="Confirm current admission information before using the packet">
      <bpmn:incoming>Flow_Task_G_UsePreprintedPack__Task_G_ConfirmCurrentInformation</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_G_ConfirmCurrentInformation__Task_RequestMHT</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_PrintNursingAdmitPack" name="Print the Nursing Admit Pack on the confirmed admission day">
      <bpmn:incoming>Flow_Gateway_RushAdmission__Task_PrintNursingAdmitPack</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PrintNursingAdmitPack__Task_RequestMHT</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_RequestMHT" name="Request an available Mental Health Technician to assist">
      <bpmn:incoming>Flow_Task_G_ConfirmCurrentInformation__Task_RequestMHT</bpmn:incoming>
      <bpmn:incoming>Flow_Task_PrintNursingAdmitPack__Task_RequestMHT</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RequestMHT__Task_SecurityReportsReady</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_SecurityReportsReady" name="Report that the Consumer is ready for nursing admission">
      <bpmn:incoming>Flow_Task_RequestMHT__Task_SecurityReportsReady</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SecurityReportsReady__Gateway_MultipleConsumers</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_MultipleConsumers" name="Multiple Consumers arrive together?" default="Flow_Gateway_MultipleConsumers__Gateway_AfterHours">
      <bpmn:documentation>- Option H — two or more Consumers require admission processing during the same period.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_SecurityReportsReady__Gateway_MultipleConsumers</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_MultipleConsumers__Gateway_AfterHours</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_MultipleConsumers__Task_H_MaintainWaitingConsumers</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_H_MaintainWaitingConsumers" name="Maintain waiting Consumers in the available secure holding area">
      <bpmn:incoming>Flow_Gateway_MultipleConsumers__Task_H_MaintainWaitingConsumers</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_H_MaintainWaitingConsumers__Task_H_ProcessEachConsumer</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_H_ProcessEachConsumer" name="Process each Consumer in turn as capacity permits">
      <bpmn:documentation>- The IR remains a single-Consumer process instance; the extraction does not specify queue-instance mechanics.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_H_MaintainWaitingConsumers__Task_H_ProcessEachConsumer</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_H_ProcessEachConsumer__Task_H_AdjustMHTAssignments</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_H_AdjustMHTAssignments" name="Adjust MHT assignments for unit staffing needs">
      <bpmn:incoming>Flow_Task_H_ProcessEachConsumer__Task_H_AdjustMHTAssignments</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_H_AdjustMHTAssignments__Gateway_AfterHours</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_AfterHours" name="Consumer arrives after hours?" default="Flow_Gateway_AfterHours__Task_BeginNursingAdmission">
      <bpmn:documentation>- Option J — a Consumer arrives outside the usual daytime admission period.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_MultipleConsumers__Gateway_AfterHours</bpmn:incoming>
      <bpmn:incoming>Flow_Task_H_AdjustMHTAssignments__Gateway_AfterHours</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_AfterHours__Task_BeginNursingAdmission</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_AfterHours__Task_J_FollowStandardProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_J_FollowStandardProcess" name="Follow the standard nursing admission process">
      <bpmn:incoming>Flow_Gateway_AfterHours__Task_J_FollowStandardProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_J_FollowStandardProcess__Task_J_CoordinateAvailability</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_J_CoordinateAvailability" name="Coordinate Physician, Security Officer, and MHT availability">
      <bpmn:incoming>Flow_Task_J_FollowStandardProcess__Task_J_CoordinateAvailability</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_J_CoordinateAvailability__Task_J_CompleteDuringShift</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_J_CompleteDuringShift" name="Plan to complete the admission during the admitting shift whenever practicable">
      <bpmn:incoming>Flow_Task_J_CoordinateAvailability__Task_J_CompleteDuringShift</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_J_CompleteDuringShift__Task_BeginNursingAdmission</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_BeginNursingAdmission" name="Report to the admissions area and begin nursing admission">
      <bpmn:incoming>Flow_Gateway_AfterHours__Task_BeginNursingAdmission</bpmn:incoming>
      <bpmn:incoming>Flow_Task_J_CompleteDuringShift__Task_BeginNursingAdmission</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_BeginNursingAdmission__Gateway_MedicalException</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_MedicalException" name="Significant medical exception identified?" default="Flow_Gateway_MedicalException__Gateway_AggressiveUnsafe">
      <bpmn:documentation>- Option C — known or observed medical needs may exceed OFC's available level of care or make routine admission medically unsafe.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_BeginNursingAdmission__Gateway_MedicalException</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_MedicalException__Gateway_AggressiveUnsafe</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_MedicalException__Task_C_AssessMedicalCondition</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_C_AssessMedicalCondition" name="Assess current medical condition and available medical records">
      <bpmn:incoming>Flow_Gateway_MedicalException__Task_C_AssessMedicalCondition</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_C_AssessMedicalCondition__Task_C_InformPhysician</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_C_InformPhysician" name="Immediately inform the Physician of the medical concern">
      <bpmn:incoming>Flow_Task_C_AssessMedicalCondition__Task_C_InformPhysician</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_C_InformPhysician__Task_C_CoordinateAdmissionStatus</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_C_CoordinateAdmissionStatus" name="Coordinate required admission-status decision with clinical leadership">
      <bpmn:incoming>Flow_Task_C_InformPhysician__Task_C_CoordinateAdmissionStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_C_CoordinateAdmissionStatus__Gateway_C_LegalReview</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_C_LegalReview" name="Legal review required?" default="Flow_Gateway_C_LegalReview__Gateway_C_SafeAtOFC">
      <bpmn:documentation>- Legal Counsel participates when acceptance, diversion, court-order, or legal-custody questions require legal review.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_C_CoordinateAdmissionStatus__Gateway_C_LegalReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_C_LegalReview__Gateway_C_SafeAtOFC</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_C_LegalReview__Task_C_LegalReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_C_LegalReview" name="Participate in acceptance, diversion, court-order, or custody review">
      <bpmn:incoming>Flow_Gateway_C_LegalReview__Task_C_LegalReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_C_LegalReview__Gateway_C_SafeAtOFC</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_C_SafeAtOFC" name="Consumer can safely be managed at OFC?" default="Flow_Gateway_C_SafeAtOFC__Task_C_DirectEmergencyOrDiversion">
      <bpmn:documentation>- The safe-to-continue decision is an IR judgment derived from the trigger and the instruction not to continue routine activities until medical disposition is resolved.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_C_LegalReview__Gateway_C_SafeAtOFC</bpmn:incoming>
      <bpmn:incoming>Flow_Task_C_LegalReview__Gateway_C_SafeAtOFC</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_C_SafeAtOFC__Task_C_DirectEmergencyOrDiversion</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_C_SafeAtOFC__Gateway_AggressiveUnsafe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_C_DirectEmergencyOrDiversion" name="Direct emergency evaluation or hospital diversion">
      <bpmn:incoming>Flow_Gateway_C_SafeAtOFC__Task_C_DirectEmergencyOrDiversion</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_C_DirectEmergencyOrDiversion__EndEvent_C_MedicalDisposition</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndEvent_C_MedicalDisposition" name="Routine nursing admission does not continue pending medical disposition">
      <bpmn:incoming>Flow_Task_C_DirectEmergencyOrDiversion__EndEvent_C_MedicalDisposition</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_AggressiveUnsafe" name="Consumer is aggressive, unsafe, or highly agitated?" default="Flow_Gateway_AggressiveUnsafe__Gateway_SameSexStaffing">
      <bpmn:documentation>- Option B — the Consumer is violent, aggressive, highly agitated, or presents an immediate behavioral safety concern during nursing admission.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_MedicalException__Gateway_AggressiveUnsafe</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_C_SafeAtOFC__Gateway_AggressiveUnsafe</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_AggressiveUnsafe__Gateway_SameSexStaffing</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_AggressiveUnsafe__Task_B_AssessSafetyConcern</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_B_AssessSafetyConcern" name="Assess the immediate clinical and safety concern">
      <bpmn:incoming>Flow_Gateway_AggressiveUnsafe__Task_B_AssessSafetyConcern</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_B_AssessSafetyConcern__Task_B_ContactPhysician</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_B_ContactPhysician" name="Contact the Physician about the safety concern">
      <bpmn:documentation>- Split from Option B step 2 to distinguish the required Physician contact from the conditional Security notification.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_B_AssessSafetyConcern__Task_B_ContactPhysician</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_B_ContactPhysician__Gateway_B_AdditionalPrecautions</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_B_AdditionalPrecautions" name="Additional security precautions required?" default="Flow_Gateway_B_AdditionalPrecautions__Gateway_B_ImmediateIntervention">
      <bpmn:incoming>Flow_Task_B_ContactPhysician__Gateway_B_AdditionalPrecautions</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_B_AdditionalPrecautions__Gateway_B_ImmediateIntervention</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_B_AdditionalPrecautions__Task_B_InformSecurity</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_B_InformSecurity" name="Inform Security Officer of required additional precautions">
      <bpmn:documentation>- Split from Option B step 2 because the extraction makes Security notification conditional.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_B_AdditionalPrecautions__Task_B_InformSecurity</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_B_InformSecurity__Gateway_B_ImmediateIntervention</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_B_ImmediateIntervention" name="Immediate medication or another clinical intervention required?" default="Flow_Gateway_B_ImmediateIntervention__Task_B_ConfirmRoutineCanContinue">
      <bpmn:incoming>Flow_Gateway_B_AdditionalPrecautions__Gateway_B_ImmediateIntervention</bpmn:incoming>
      <bpmn:incoming>Flow_Task_B_InformSecurity__Gateway_B_ImmediateIntervention</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_B_ImmediateIntervention__Task_B_ConfirmRoutineCanContinue</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_B_ImmediateIntervention__Task_B_AdjustPrecautions</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_B_AdjustPrecautions" name="Adjust movement or staffing precautions according to clinical direction">
      <bpmn:incoming>Flow_Gateway_B_ImmediateIntervention__Task_B_AdjustPrecautions</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_B_AdjustPrecautions__Task_B_ConfirmRoutineCanContinue</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_B_ConfirmRoutineCanContinue" name="Confirm with the Physician that routine admission activities can continue">
      <bpmn:incoming>Flow_Gateway_B_ImmediateIntervention__Task_B_ConfirmRoutineCanContinue</bpmn:incoming>
      <bpmn:incoming>Flow_Task_B_AdjustPrecautions__Task_B_ConfirmRoutineCanContinue</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_B_ConfirmRoutineCanContinue__Gateway_SameSexStaffing</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_SameSexStaffing" name="Same-sex staffing required for personal-care activity?" default="Flow_Gateway_SameSexStaffing__Task_LiceCheckTreatment">
      <bpmn:documentation>- Option A — the Consumer is female and same-sex staffing is required for the search, shower, or related personal-care activities.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_AggressiveUnsafe__Gateway_SameSexStaffing</bpmn:incoming>
      <bpmn:incoming>Flow_Task_B_ConfirmRoutineCanContinue__Gateway_SameSexStaffing</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_SameSexStaffing__Task_LiceCheckTreatment</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_SameSexStaffing__Task_A_ConfirmFemaleStaff</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_A_ConfirmFemaleStaff" name="Coordinate with Security Officer to confirm available female staff">
      <bpmn:incoming>Flow_Gateway_SameSexStaffing__Task_A_ConfirmFemaleStaff</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_A_ConfirmFemaleStaff__Gateway_A_FemaleSecurityAvailable</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_A_FemaleSecurityAvailable" name="Female Security Officer available?" default="Flow_Gateway_A_FemaleSecurityAvailable__Task_A_MaintainSameSexSupervision">
      <bpmn:incoming>Flow_Task_A_ConfirmFemaleStaff__Gateway_A_FemaleSecurityAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_A_FemaleSecurityAvailable__Task_A_MaintainSameSexSupervision</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_A_FemaleSecurityAvailable__Task_A_FemaleMHTAssists</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_A_FemaleMHTAssists" name="Have a female MHT or other authorized female staff member assist">
      <bpmn:incoming>Flow_Gateway_A_FemaleSecurityAvailable__Task_A_FemaleMHTAssists</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_A_FemaleMHTAssists__Task_A_MaintainSameSexSupervision</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_A_MaintainSameSexSupervision" name="Maintain same-sex supervision during the applicable activity">
      <bpmn:documentation>- Ownership is a modeling judgment: the extraction names only Staff, so the task is assigned to the Unit Nurse as the admission owner.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_A_FemaleSecurityAvailable__Task_A_MaintainSameSexSupervision</bpmn:incoming>
      <bpmn:incoming>Flow_Task_A_FemaleMHTAssists__Task_A_MaintainSameSexSupervision</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_A_MaintainSameSexSupervision__Task_LiceCheckTreatment</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_LiceCheckTreatment" name="Perform required lice check and treatment">
      <bpmn:incoming>Flow_Gateway_SameSexStaffing__Task_LiceCheckTreatment</bpmn:incoming>
      <bpmn:incoming>Flow_Task_A_MaintainSameSexSupervision__Task_LiceCheckTreatment</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_LiceCheckTreatment__Task_BeginBiophysicalAssessment</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_BeginBiophysicalAssessment" name="Interview Consumer and begin Nursing Unit Biophysical Assessment, including scarring and tattoo sheet">
      <bpmn:incoming>Flow_Task_LiceCheckTreatment__Task_BeginBiophysicalAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_BeginBiophysicalAssessment__Gateway_CannotParticipate</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_CannotParticipate" name="Consumer cannot meaningfully participate?" default="Flow_Gateway_CannotParticipate__Task_AssistShower">
      <bpmn:documentation>- Option F — the Consumer is unable or unwilling to participate effectively in questioning, consent review, or informational activities because of current behavior or mental status.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_BeginBiophysicalAssessment__Gateway_CannotParticipate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_CannotParticipate__Task_AssistShower</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_CannotParticipate__Task_F_CompleteSafeActivities</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_F_CompleteSafeActivities" name="Complete clinical activities that can safely be performed">
      <bpmn:incoming>Flow_Gateway_CannotParticipate__Task_F_CompleteSafeActivities</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_F_CompleteSafeActivities__Task_F_DocumentCooperation</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_F_DocumentCooperation" name="Document cooperation level and observed condition">
      <bpmn:incoming>Flow_Task_F_CompleteSafeActivities__Task_F_DocumentCooperation</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_F_DocumentCooperation__Task_F_LeaveUnavailableInfoUnresolved</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_F_LeaveUnavailableInfoUnresolved" name="Leave unavailable historical information unresolved rather than inventing responses">
      <bpmn:incoming>Flow_Task_F_DocumentCooperation__Task_F_LeaveUnavailableInfoUnresolved</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_F_LeaveUnavailableInfoUnresolved__Task_F_ReturnToUnresolvedItems</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_F_ReturnToUnresolvedItems" name="Return to unresolved questions or documents when clinically appropriate">
      <bpmn:documentation>- The extraction does not identify a specific re-entry step, so this task rejoins the next modeled nursing activity.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_F_LeaveUnavailableInfoUnresolved__Task_F_ReturnToUnresolvedItems</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_F_ReturnToUnresolvedItems__Task_F_ContinueNonvoluntaryActivities</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_F_ContinueNonvoluntaryActivities" name="Continue custody, safety, and treatment activities not dependent on voluntary participation">
      <bpmn:incoming>Flow_Task_F_ReturnToUnresolvedItems__Task_F_ContinueNonvoluntaryActivities</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_F_ContinueNonvoluntaryActivities__Task_AssistShower</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_AssistShower" name="Assist with shower process under staffing and supervision requirements">
      <bpmn:incoming>Flow_Gateway_CannotParticipate__Task_AssistShower</bpmn:incoming>
      <bpmn:incoming>Flow_Task_F_ContinueNonvoluntaryActivities__Task_AssistShower</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AssistShower__Task_ConsumerCompletesShower</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_ConsumerCompletesShower" name="Complete shower">
      <bpmn:incoming>Flow_Task_AssistShower__Task_ConsumerCompletesShower</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ConsumerCompletesShower__Task_EscortToUnit</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_EscortToUnit" name="Escort Consumer with MHT from shower area to assigned unit">
      <bpmn:incoming>Flow_Task_ConsumerCompletesShower__Task_EscortToUnit</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_EscortToUnit__Task_ReceiveConsumerAndVitals</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_ReceiveConsumerAndVitals" name="Receive Consumer on unit and obtain complete vital signs">
      <bpmn:incoming>Flow_Task_EscortToUnit__Task_ReceiveConsumerAndVitals</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ReceiveConsumerAndVitals__Task_UpdateBiophysicalAssessment</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_UpdateBiophysicalAssessment" name="Update Biophysical Assessment and record vital-sign information">
      <bpmn:incoming>Flow_Task_ReceiveConsumerAndVitals__Task_UpdateBiophysicalAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_UpdateBiophysicalAssessment__Task_CompleteTraumaAndSuicideAssessment</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_CompleteTraumaAndSuicideAssessment" name="Complete nursing trauma questions and initial suicide-risk assessment">
      <bpmn:incoming>Flow_Task_UpdateBiophysicalAssessment__Task_CompleteTraumaAndSuicideAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CompleteTraumaAndSuicideAssessment__Task_CompleteSafeTSteps1And2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_CompleteSafeTSteps1And2" name="Complete SAFE-T Protocol Signature Page steps 1 and 2">
      <bpmn:incoming>Flow_Task_CompleteTraumaAndSuicideAssessment__Task_CompleteSafeTSteps1And2</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CompleteSafeTSteps1And2__Task_ContactPhysicianForEncounter</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_ContactPhysicianForEncounter" name="Contact Physician when Consumer is ready for physician encounter; Social Worker may arrange remote telemedicine">
      <bpmn:incoming>Flow_Task_CompleteSafeTSteps1And2__Task_ContactPhysicianForEncounter</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ContactPhysicianForEncounter__Task_PhysicianInterview</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_PhysicianInterview" name="Interview Consumer on medical history, mental-health history, trauma, suicide risk, substance use, current condition, and admission issues">
      <bpmn:incoming>Flow_Task_ContactPhysicianForEncounter__Task_PhysicianInterview</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PhysicianInterview__Task_PhysicianPaperworkAndSafeT</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_PhysicianPaperworkAndSafeT" name="Complete physician admission paperwork and SAFE-T Protocol Signature Page steps 3 through 5">
      <bpmn:incoming>Flow_Task_PhysicianInterview__Task_PhysicianPaperworkAndSafeT</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PhysicianPaperworkAndSafeT__Gateway_MedicationHistoryUnavailable</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_MedicationHistoryUnavailable" name="Medication history unavailable?" default="Flow_Gateway_MedicationHistoryUnavailable__Task_CompleteMedicationReconciliation">
      <bpmn:documentation>- Option D — the Physician, Unit Nurse, and Consumer cannot establish the Consumer's current or recent medication regimen.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_PhysicianPaperworkAndSafeT__Gateway_MedicationHistoryUnavailable</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_MedicationHistoryUnavailable__Task_CompleteMedicationReconciliation</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_MedicationHistoryUnavailable__Task_D_InformPhysician</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_D_InformPhysician" name="Inform Physician that medication history is incomplete">
      <bpmn:incoming>Flow_Gateway_MedicationHistoryUnavailable__Task_D_InformPhysician</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_D_InformPhysician__Gateway_D_AdditionalInformationRequested</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_D_AdditionalInformationRequested" name="Physician requests additional medication information?" default="Flow_Gateway_D_AdditionalInformationRequested__Task_CompleteMedicationReconciliation">
      <bpmn:incoming>Flow_Task_D_InformPhysician__Gateway_D_AdditionalInformationRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_D_AdditionalInformationRequested__Task_CompleteMedicationReconciliation</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_D_AdditionalInformationRequested__Task_D_ContactOriginatingJail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_D_ContactOriginatingJail" name="Contact Originating Jail Staff for medication information">
      <bpmn:incoming>Flow_Gateway_D_AdditionalInformationRequested__Task_D_ContactOriginatingJail</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_D_ContactOriginatingJail__Task_D_ProvideMedicationInformation</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_D_ProvideMedicationInformation" name="Provide available medication information">
      <bpmn:incoming>Flow_Task_D_ContactOriginatingJail__Task_D_ProvideMedicationInformation</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_D_ProvideMedicationInformation__Task_D_UpdateReconciliation</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_D_UpdateReconciliation" name="Update Medication Reconciliation Form with verified information">
      <bpmn:incoming>Flow_Task_D_ProvideMedicationInformation__Task_D_UpdateReconciliation</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_D_UpdateReconciliation__Task_CompleteMedicationReconciliation</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_CompleteMedicationReconciliation" name="Complete Medication Reconciliation Form with Physician">
      <bpmn:incoming>Flow_Gateway_MedicationHistoryUnavailable__Task_CompleteMedicationReconciliation</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_D_AdditionalInformationRequested__Task_CompleteMedicationReconciliation</bpmn:incoming>
      <bpmn:incoming>Flow_Task_D_UpdateReconciliation__Task_CompleteMedicationReconciliation</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CompleteMedicationReconciliation__Task_OfferConsentDocuments</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_OfferConsentDocuments" name="Offer required consent documents after physician encounter and record signatures">
      <bpmn:incoming>Flow_Task_CompleteMedicationReconciliation__Task_OfferConsentDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_OfferConsentDocuments__Gateway_ConsentRefusal</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_ConsentRefusal" name="Consumer declines one or more consent documents?" default="Flow_Gateway_ConsentRefusal__Task_ConsumerSignsConsent">
      <bpmn:documentation>- Option E — the Consumer declines to sign one or more consent documents.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_OfferConsentDocuments__Gateway_ConsentRefusal</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ConsentRefusal__Task_ConsumerSignsConsent</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_ConsentRefusal__Task_E_ExplainAndOfferConsent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_E_ExplainAndOfferConsent" name="Explain applicable document and offer Consumer opportunity to sign">
      <bpmn:incoming>Flow_Gateway_ConsentRefusal__Task_E_ExplainAndOfferConsent</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_E_ExplainAndOfferConsent__Gateway_E_SignsAfterExplanation</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_E_SignsAfterExplanation" name="Consumer signs after explanation?" default="Flow_Gateway_E_SignsAfterExplanation__Task_E_ConsumerRefusesConsent">
      <bpmn:incoming>Flow_Task_E_ExplainAndOfferConsent__Gateway_E_SignsAfterExplanation</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_E_SignsAfterExplanation__Task_E_ConsumerRefusesConsent</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_E_SignsAfterExplanation__Task_ConsumerSignsConsent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_E_ConsumerRefusesConsent" name="Refuse voluntary consent document">
      <bpmn:incoming>Flow_Gateway_E_SignsAfterExplanation__Task_E_ConsumerRefusesConsent</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_E_ConsumerRefusesConsent__Task_E_RecordRefusal</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_E_RecordRefusal" name="Record refusal using the applicable form or documentation process">
      <bpmn:incoming>Flow_Task_E_ConsumerRefusesConsent__Task_E_RecordRefusal</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_E_RecordRefusal__Gateway_E_SeparateBarrier</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_E_SeparateBarrier" name="Separate legal or clinical barrier created by refusal?" default="Flow_Gateway_E_SeparateBarrier__Task_E_ContinueAdmission">
      <bpmn:incoming>Flow_Task_E_RecordRefusal__Gateway_E_SeparateBarrier</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_E_SeparateBarrier__Task_E_ContinueAdmission</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_E_SeparateBarrier__EndEvent_E_SeparateResolution</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_E_ContinueAdmission" name="Continue the remainder of admission">
      <bpmn:incoming>Flow_Gateway_E_SeparateBarrier__Task_E_ContinueAdmission</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_E_ContinueAdmission__Gateway_PsychoactiveMedication</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndEvent_E_SeparateResolution" name="Routine admission awaits separate legal or clinical resolution">
      <bpmn:incoming>Flow_Gateway_E_SeparateBarrier__EndEvent_E_SeparateResolution</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Task_ConsumerSignsConsent" name="Sign consent documents">
      <bpmn:incoming>Flow_Gateway_ConsentRefusal__Task_ConsumerSignsConsent</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_E_SignsAfterExplanation__Task_ConsumerSignsConsent</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ConsumerSignsConsent__Gateway_PsychoactiveMedication</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_PsychoactiveMedication" name="Psychoactive medication prescribed or proposed?" default="Flow_Gateway_PsychoactiveMedication__Task_OrientConsumerToUnit">
      <bpmn:incoming>Flow_Task_E_ContinueAdmission__Gateway_PsychoactiveMedication</bpmn:incoming>
      <bpmn:incoming>Flow_Task_ConsumerSignsConsent__Gateway_PsychoactiveMedication</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_PsychoactiveMedication__Task_OrientConsumerToUnit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_PsychoactiveMedication__Task_ReviewPsychoactiveConsent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_ReviewPsychoactiveConsent" name="Review Consent for Treatment with Psychoactive Medication with Consumer">
      <bpmn:incoming>Flow_Gateway_PsychoactiveMedication__Task_ReviewPsychoactiveConsent</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ReviewPsychoactiveConsent__Task_OrientConsumerToUnit</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_OrientConsumerToUnit" name="Orient Consumer to assigned unit locations">
      <bpmn:incoming>Flow_Gateway_PsychoactiveMedication__Task_OrientConsumerToUnit</bpmn:incoming>
      <bpmn:incoming>Flow_Task_ReviewPsychoactiveConsent__Task_OrientConsumerToUnit</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_OrientConsumerToUnit__Task_GiveInformationalMaterials</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_GiveInformationalMaterials" name="Give Consumer informational materials and explain they are not mandatory consent documents">
      <bpmn:incoming>Flow_Task_OrientConsumerToUnit__Task_GiveInformationalMaterials</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_GiveInformationalMaterials__Task_CollateAdmissionRecord</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_CollateAdmissionRecord" name="Collate completed nursing, physician, and applicable security paperwork">
      <bpmn:incoming>Flow_Task_GiveInformationalMaterials__Task_CollateAdmissionRecord</bpmn:incoming>
