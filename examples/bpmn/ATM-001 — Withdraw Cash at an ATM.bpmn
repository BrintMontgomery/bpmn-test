<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ATM_Withdrawal" targetNamespace="https://oklahoma.gov/odmhsas/ofc/bpmn/atm-withdrawal" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.24.0">
  <bpmn:collaboration id="Collaboration_ATM_Withdrawal">
    <bpmn:participant id="Participant_ATM_Withdrawal" name="ATM Withdrawal" processRef="atm_withdrawal_v1" />
    <bpmn:textAnnotation id="Ann_main_04_verify_pin">
      <bpmn:text>a: PIN retry limits and card-retention behavior are set by the Financial Institution and may differ by card issuer.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_main_04_verify_pin" sourceRef="main_04_verify_pin" targetRef="Ann_main_04_verify_pin" />
    <bpmn:textAnnotation id="Ann_option_a_03_retain_or_return_card">
      <bpmn:text>a: PIN retry limits and card-retention behavior are set by the Financial Institution and may differ by card issuer.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_option_a_03_retain_or_return_card" sourceRef="option_a_03_retain_or_return_card" targetRef="Ann_option_a_03_retain_or_return_card" />
  </bpmn:collaboration>
  <bpmn:process id="atm_withdrawal_v1" name="Withdraw Cash at an ATM" isExecutable="false">
    <bpmn:documentation>- Source context: This procedure describes a cardholder withdrawing cash from an automated teller machine (ATM) using a debit card and PIN. Preconditions: the cardholder has an active debit card, knows the PIN, can access the selected account, and uses an available ATM with sufficient cash to operate. Outcome: the cardholder receives the requested cash and retrieves the debit card; the Financial Institution records the withdrawal. If completion fails, the ATM provides an appropriate message without dispensing cash. Modeling judgments: the first bold actor owns each main-path task. Option steps have no bold-actor extraction, so ownership follows the grammatical actor named in each step; this is an inference. The Financial Institution lane is retained because it is an extracted actor, but it has no separate task because it appears as a counterparty in the extracted ATM steps and no explicit lane handoff is specified. The start event, end events, and exclusive gateways are inferred BPMN control-flow elements. The three option triggers are represented by entry gateways in the main path. Option A has an internal retry-limit gateway; Option B has an internal smaller-amount-or-cancel gateway. Option C has no additional conditional branch. All branches share the single Main path and exception handling phase because their loops and rejoin points make separate later phases incompatible with the global layout ordering. No decomposition proposals are made, so no split rationales are applicable.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_atm_withdrawal_v1">
      <bpmn:lane id="lane_financial_institution" name="Financial Institution">
        <bpmn:flowNodeRef>main_08_debit_account</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_atm" name="ATM">
        <bpmn:flowNodeRef>main_02_read_prompt_pin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_04_verify_pin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_gw_pin_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_05_display_options</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_07_verify_funds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_gw_funds_entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_10_return_card_receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_a_01_inform_pin_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_a_gw_retry_limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_a_02_permit_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_a_03_retain_or_return_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_a_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_b_03_return_card_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_b_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_c_01_cancel_transaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_c_02_return_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_09_dispense_cash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_b_01_inform_insufficient_funds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_b_02_prompt_smaller_or_cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_cardholder" name="Cardholder">
        <bpmn:flowNodeRef>start_withdrawal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_01_insert_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_03_enter_pin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_06_select_withdrawal_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_gw_cancel_entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_11_retrieve_outputs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_b_gw_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_c_03_retrieve_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>option_c_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_withdrawal" name="Withdrawal starts">
      <bpmn:documentation>- Inferred start event before main-path step 1; the extraction does not specify a separate start trigger.</bpmn:documentation>
      <bpmn:outgoing>Flow_start_withdrawal__main_01_insert_card</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_start_withdrawal" />
    </bpmn:startEvent>
    <bpmn:manualTask id="main_01_insert_card" name="Insert debit card into ATM">
      <bpmn:documentation>- Main-path step 1, source line 30: Cardholder inserts the debit card into the ATM.</bpmn:documentation>
      <bpmn:incoming>Flow_start_withdrawal__main_01_insert_card</bpmn:incoming>
      <bpmn:outgoing>Flow_main_01_insert_card__main_02_read_prompt_pin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="main_02_read_prompt_pin" name="Read card and prompt for PIN">
      <bpmn:documentation>- Main-path step 2, source line 31: ATM reads the card and prompts the Cardholder to enter the PIN.</bpmn:documentation>
      <bpmn:incoming>Flow_main_01_insert_card__main_02_read_prompt_pin</bpmn:incoming>
      <bpmn:outgoing>Flow_main_02_read_prompt_pin__main_03_enter_pin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="main_03_enter_pin" name="Enter PIN">
      <bpmn:documentation>- Main-path step 3, source line 32: Cardholder enters the PIN.</bpmn:documentation>
      <bpmn:incoming>Flow_main_02_read_prompt_pin__main_03_enter_pin</bpmn:incoming>
      <bpmn:incoming>Flow_option_a_02_permit_retry__main_03_enter_pin</bpmn:incoming>
      <bpmn:outgoing>Flow_main_03_enter_pin__main_04_verify_pin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="main_04_verify_pin" name="Verify PIN with Financial Institution">
      <bpmn:documentation>- Main-path step 4, source line 33: ATM verifies the PIN with the Financial Institution.</bpmn:documentation>
      <bpmn:incoming>Flow_main_03_enter_pin__main_04_verify_pin</bpmn:incoming>
      <bpmn:outgoing>Flow_main_04_verify_pin__main_gw_pin_result</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="main_gw_pin_result" name="Option A entry: PIN verified?" default="Flow_main_gw_pin_result__main_05_display_options">
      <bpmn:documentation>- Exclusive gateway inferred from the PIN-incorrect trigger for Option A at source line 44.</bpmn:documentation>
      <bpmn:incoming>Flow_main_04_verify_pin__main_gw_pin_result</bpmn:incoming>
      <bpmn:outgoing>Flow_main_gw_pin_result__main_05_display_options</bpmn:outgoing>
      <bpmn:outgoing>Flow_main_gw_pin_result__option_a_01_inform_pin_failure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="main_05_display_options" name="Display transaction options">
      <bpmn:documentation>- Main-path step 5, source line 34: ATM displays transaction options to the Cardholder.</bpmn:documentation>
      <bpmn:incoming>Flow_main_gw_pin_result__main_05_display_options</bpmn:incoming>
      <bpmn:outgoing>Flow_main_05_display_options__main_06_select_withdrawal_amount</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="main_06_select_withdrawal_amount" name="Select cash withdrawal and enter requested amount">
      <bpmn:documentation>- Main-path step 6, source line 35: Cardholder selects a cash withdrawal and enters the requested amount.</bpmn:documentation>
      <bpmn:incoming>Flow_main_05_display_options__main_06_select_withdrawal_amount</bpmn:incoming>
      <bpmn:incoming>Flow_option_b_gw_choice__main_06_select_withdrawal_amount</bpmn:incoming>
      <bpmn:outgoing>Flow_main_06_select_withdrawal_amount__main_gw_cancel_entry</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="main_gw_cancel_entry" name="Option C entry: Cardholder cancels before cash is dispensed?" default="Flow_main_gw_cancel_entry__main_07_verify_funds">
      <bpmn:documentation>- Exclusive gateway inferred from the Option C trigger at source line 60; the gateway is placed after amount entry and before cash dispensing.</bpmn:documentation>
      <bpmn:incoming>Flow_main_06_select_withdrawal_amount__main_gw_cancel_entry</bpmn:incoming>
      <bpmn:outgoing>Flow_main_gw_cancel_entry__option_c_01_cancel_transaction</bpmn:outgoing>
      <bpmn:outgoing>Flow_main_gw_cancel_entry__main_07_verify_funds</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="main_07_verify_funds" name="Verify sufficient available funds">
      <bpmn:documentation>- Main-path step 7, source line 36: ATM verifies with the Financial Institution that the account has sufficient available funds.</bpmn:documentation>
      <bpmn:incoming>Flow_main_gw_cancel_entry__main_07_verify_funds</bpmn:incoming>
      <bpmn:outgoing>Flow_main_07_verify_funds__main_gw_funds_entry</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="main_gw_funds_entry" name="Option B entry: Account has sufficient available funds?" default="Flow_main_gw_funds_entry__main_08_debit_account">
      <bpmn:documentation>- Exclusive gateway inferred from the insufficient-funds trigger for Option B at source line 52.</bpmn:documentation>
      <bpmn:incoming>Flow_main_07_verify_funds__main_gw_funds_entry</bpmn:incoming>
      <bpmn:outgoing>Flow_main_gw_funds_entry__main_08_debit_account</bpmn:outgoing>
      <bpmn:outgoing>Flow_main_gw_funds_entry__option_b_01_inform_insufficient_funds</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="main_10_return_card_receipt" name="Return debit card and offer receipt">
      <bpmn:documentation>- Main-path step 10, source line 39: ATM returns the debit card and offers a receipt to the Cardholder.</bpmn:documentation>
      <bpmn:incoming>Flow_main_09_dispense_cash__main_10_return_card_receipt</bpmn:incoming>
      <bpmn:outgoing>Flow_main_10_return_card_receipt__main_11_retrieve_outputs</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="main_11_retrieve_outputs" name="Take cash, debit card, and requested receipt">
      <bpmn:documentation>- Main-path step 11, source line 40: Cardholder takes the cash and debit card, and takes the receipt if requested.</bpmn:documentation>
      <bpmn:incoming>Flow_main_10_return_card_receipt__main_11_retrieve_outputs</bpmn:incoming>
      <bpmn:outgoing>Flow_main_11_retrieve_outputs__main_end_success</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="main_end_success" name="Withdrawal completed">
      <bpmn:documentation>- End event inferred after main-path step 11.</bpmn:documentation>
      <bpmn:incoming>Flow_main_11_retrieve_outputs__main_end_success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="option_a_01_inform_pin_failure" name="Inform Cardholder that PIN could not be verified">
      <bpmn:documentation>- Option A step 1, source line 48. Ownership inferred from the named ATM actor.</bpmn:documentation>
      <bpmn:incoming>Flow_main_gw_pin_result__option_a_01_inform_pin_failure</bpmn:incoming>
      <bpmn:outgoing>Flow_option_a_01_inform_pin_failure__option_a_gw_retry_limit</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="option_a_gw_retry_limit" name="PIN retry limit reached?" default="Flow_option_a_gw_retry_limit__option_a_02_permit_retry">
      <bpmn:documentation>- Internal exclusive gateway required by the conditional in Option A step 3, source line 50.</bpmn:documentation>
      <bpmn:incoming>Flow_option_a_01_inform_pin_failure__option_a_gw_retry_limit</bpmn:incoming>
      <bpmn:outgoing>Flow_option_a_gw_retry_limit__option_a_02_permit_retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_option_a_gw_retry_limit__option_a_03_retain_or_return_card</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="option_a_02_permit_retry" name="Permit another PIN entry">
      <bpmn:documentation>- Option A step 2, source line 49. Ownership inferred from the named ATM actor.</bpmn:documentation>
      <bpmn:incoming>Flow_option_a_gw_retry_limit__option_a_02_permit_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_option_a_02_permit_retry__main_03_enter_pin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="option_a_03_retain_or_return_card" name="Retain or return card according to Financial Institution policy">
      <bpmn:documentation>- Option A step 3, source line 50.</bpmn:documentation>
      <bpmn:incoming>Flow_option_a_gw_retry_limit__option_a_03_retain_or_return_card</bpmn:incoming>
      <bpmn:outgoing>Flow_option_a_03_retain_or_return_card__option_a_end</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="option_a_end" name="PIN transaction ended">
      <bpmn:documentation>- End event inferred from Option A step 3.</bpmn:documentation>
      <bpmn:incoming>Flow_option_a_03_retain_or_return_card__option_a_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="option_b_gw_choice" name="Cardholder enters smaller amount or cancels?" default="Flow_option_b_gw_choice__main_06_select_withdrawal_amount">
      <bpmn:documentation>- Internal exclusive gateway required by the conditional in Option B step 3, source line 58.</bpmn:documentation>
      <bpmn:incoming>Flow_option_b_02_prompt_smaller_or_cancel__option_b_gw_choice</bpmn:incoming>
      <bpmn:outgoing>Flow_option_b_gw_choice__main_06_select_withdrawal_amount</bpmn:outgoing>
      <bpmn:outgoing>Flow_option_b_gw_choice__option_b_03_return_card_cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="option_b_03_return_card_cancel" name="Return card and end without dispensing cash">
      <bpmn:documentation>- Option B step 3, source line 58. Ownership inferred from the named ATM actor.</bpmn:documentation>
      <bpmn:incoming>Flow_option_b_gw_choice__option_b_03_return_card_cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_option_b_03_return_card_cancel__option_b_end</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="option_b_end" name="Insufficient-funds transaction ended">
      <bpmn:documentation>- End event inferred from Option B step 3.</bpmn:documentation>
      <bpmn:incoming>Flow_option_b_03_return_card_cancel__option_b_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="option_c_01_cancel_transaction" name="Cancel transaction before debiting account">
      <bpmn:documentation>- Option C step 1, source line 64. Ownership inferred from the named ATM actor.</bpmn:documentation>
      <bpmn:incoming>Flow_main_gw_cancel_entry__option_c_01_cancel_transaction</bpmn:incoming>
      <bpmn:outgoing>Flow_option_c_01_cancel_transaction__option_c_02_return_card</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="option_c_02_return_card" name="Return debit card">
      <bpmn:documentation>- Option C step 2, source line 65. Ownership inferred from the named ATM actor.</bpmn:documentation>
      <bpmn:incoming>Flow_option_c_01_cancel_transaction__option_c_02_return_card</bpmn:incoming>
      <bpmn:outgoing>Flow_option_c_02_return_card__option_c_03_retrieve_card</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="option_c_03_retrieve_card" name="Retrieve debit card">
      <bpmn:documentation>- Option C step 3, source line 66. Ownership inferred from the named Cardholder actor.</bpmn:documentation>
      <bpmn:incoming>Flow_option_c_02_return_card__option_c_03_retrieve_card</bpmn:incoming>
      <bpmn:outgoing>Flow_option_c_03_retrieve_card__option_c_end</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="option_c_end" name="Cancellation completed">
      <bpmn:documentation>- End event inferred after Option C step 3.</bpmn:documentation>
      <bpmn:incoming>Flow_option_c_03_retrieve_card__option_c_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="main_08_debit_account" name="Debit selected account">
      <bpmn:documentation>- Main-path step 8, source line 37: ATM debits the selected account through the Financial Institution.</bpmn:documentation>
      <bpmn:incoming>Flow_main_gw_funds_entry__main_08_debit_account</bpmn:incoming>
      <bpmn:outgoing>Flow_main_08_debit_account__main_09_dispense_cash</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="main_09_dispense_cash" name="Dispense requested cash">
      <bpmn:documentation>- Main-path step 9, source line 38: ATM dispenses the requested cash.</bpmn:documentation>
      <bpmn:incoming>Flow_main_08_debit_account__main_09_dispense_cash</bpmn:incoming>
      <bpmn:outgoing>Flow_main_09_dispense_cash__main_10_return_card_receipt</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="option_b_01_inform_insufficient_funds" name="Inform Cardholder that requested amount cannot be withdrawn">
      <bpmn:documentation>- Option B step 1, source line 56. Ownership inferred from the named ATM actor.</bpmn:documentation>
      <bpmn:incoming>Flow_main_gw_funds_entry__option_b_01_inform_insufficient_funds</bpmn:incoming>
      <bpmn:outgoing>Flow_option_b_01_inform_insufficient_funds__option_b_02_prompt_smaller_or_cancel</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="option_b_02_prompt_smaller_or_cancel" name="Prompt for a smaller amount or cancellation">
      <bpmn:documentation>- Option B step 2, source line 57. Ownership inferred from the named ATM actor.</bpmn:documentation>
      <bpmn:incoming>Flow_option_b_01_inform_insufficient_funds__option_b_02_prompt_smaller_or_cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_option_b_02_prompt_smaller_or_cancel__option_b_gw_choice</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_start_withdrawal__main_01_insert_card" sourceRef="start_withdrawal" targetRef="main_01_insert_card" />
    <bpmn:sequenceFlow id="Flow_main_01_insert_card__main_02_read_prompt_pin" sourceRef="main_01_insert_card" targetRef="main_02_read_prompt_pin" />
    <bpmn:sequenceFlow id="Flow_main_02_read_prompt_pin__main_03_enter_pin" sourceRef="main_02_read_prompt_pin" targetRef="main_03_enter_pin" />
    <bpmn:sequenceFlow id="Flow_option_a_02_permit_retry__main_03_enter_pin" name="Another PIN entry" sourceRef="option_a_02_permit_retry" targetRef="main_03_enter_pin" />
    <bpmn:sequenceFlow id="Flow_main_03_enter_pin__main_04_verify_pin" sourceRef="main_03_enter_pin" targetRef="main_04_verify_pin" />
    <bpmn:sequenceFlow id="Flow_main_04_verify_pin__main_gw_pin_result" sourceRef="main_04_verify_pin" targetRef="main_gw_pin_result" />
    <bpmn:sequenceFlow id="Flow_main_gw_pin_result__main_05_display_options" name="PIN verified" sourceRef="main_gw_pin_result" targetRef="main_05_display_options" />
    <bpmn:sequenceFlow id="Flow_main_gw_pin_result__option_a_01_inform_pin_failure" name="PIN incorrect" sourceRef="main_gw_pin_result" targetRef="option_a_01_inform_pin_failure">
      <bpmn:conditionExpression>ATM reports that the entered PIN is incorrect</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_main_05_display_options__main_06_select_withdrawal_amount" sourceRef="main_05_display_options" targetRef="main_06_select_withdrawal_amount" />
    <bpmn:sequenceFlow id="Flow_option_b_gw_choice__main_06_select_withdrawal_amount" name="Enter smaller amount" sourceRef="option_b_gw_choice" targetRef="main_06_select_withdrawal_amount" />
    <bpmn:sequenceFlow id="Flow_main_06_select_withdrawal_amount__main_gw_cancel_entry" sourceRef="main_06_select_withdrawal_amount" targetRef="main_gw_cancel_entry" />
    <bpmn:sequenceFlow id="Flow_main_gw_cancel_entry__option_c_01_cancel_transaction" name="Cancel" sourceRef="main_gw_cancel_entry" targetRef="option_c_01_cancel_transaction">
      <bpmn:conditionExpression>Cardholder selects cancel before cash is dispensed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_main_gw_cancel_entry__main_07_verify_funds" name="Continue" sourceRef="main_gw_cancel_entry" targetRef="main_07_verify_funds" />
    <bpmn:sequenceFlow id="Flow_main_07_verify_funds__main_gw_funds_entry" sourceRef="main_07_verify_funds" targetRef="main_gw_funds_entry" />
    <bpmn:sequenceFlow id="Flow_main_gw_funds_entry__main_08_debit_account" name="Sufficient funds" sourceRef="main_gw_funds_entry" targetRef="main_08_debit_account" />
    <bpmn:sequenceFlow id="Flow_main_gw_funds_entry__option_b_01_inform_insufficient_funds" name="Insufficient funds" sourceRef="main_gw_funds_entry" targetRef="option_b_01_inform_insufficient_funds">
      <bpmn:conditionExpression>Financial Institution reports insufficient available funds</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_main_09_dispense_cash__main_10_return_card_receipt" sourceRef="main_09_dispense_cash" targetRef="main_10_return_card_receipt" />
    <bpmn:sequenceFlow id="Flow_main_10_return_card_receipt__main_11_retrieve_outputs" sourceRef="main_10_return_card_receipt" targetRef="main_11_retrieve_outputs" />
