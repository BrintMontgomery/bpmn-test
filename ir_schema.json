{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oklahoma.gov/odmhsas/ofc/bpmn/ir-schema-v1.json",
  "title": "OFC BPMN intermediate representation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "process_id",
    "participant_name",
    "process_doc",
    "lanes",
    "phases",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "process_id": {"type": "string", "minLength": 1},
    "participant_name": {"type": "string", "minLength": 1},
    "process_doc": {"type": "string"},
    "process_name": {"type": "string", "minLength": 1},
    "participant_id": {"type": "string", "minLength": 1},
    "collaboration_id": {"type": "string", "minLength": 1},
    "definitions_id": {"type": "string", "minLength": 1},
    "exporter": {"type": "string", "minLength": 1},
    "exporter_version": {"type": "string", "minLength": 1},
    "target_namespace": {"type": "string", "minLength": 1},
    "ann_above": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "lane_classes": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "mermaid_class_defs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lane"}
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/phase"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "external_pools": {
      "type": "array",
      "items": {"$ref": "#/$defs/external_pool"}
    },
    "message_flows": {
      "type": "array",
      "items": {"$ref": "#/$defs/message_flow"}
    }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "ann_above": {"type": "boolean"}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "lane", "phase", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "task",
            "gateway_x",
            "gateway_p",
            "start_message",
            "catch_timer",
            "catch_message",
            "end"
          ]
        },
        "lane": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "ttype": {"enum": ["manual", "user", "send", "receive"]},
        "doc": {
          "type": "array",
          "items": {"type": "string"}
        },
        "note": {"type": ["string", "null"]},
        "parent": {"type": ["string", "null"], "minLength": 1}
      },
      "oneOf": [
        {
          "properties": {"kind": {"const": "task"}}
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "gateway_x",
                "gateway_p",
                "start_message",
                "catch_timer",
                "catch_message",
                "end"
              ]
            }
          },
          "not": {"required": ["ttype"]}
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "condition": {"type": "string"},
        "loop": {"type": "boolean"}
      }
    },
    "external_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "anchor"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "anchor": {"type": "string", "minLength": 1},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "gap_above": {"type": "number", "minimum": 0},
        "mermaid_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "message_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "mermaid_name": {"type": ["string", "null"]},
        "label_width": {"type": "number", "exclusiveMinimum": 0},
        "label_height": {"type": "number", "exclusiveMinimum": 0},
        "label_dx": {"type": "number"},
        "label_dy": {"type": "number"}
      }
    }
  }
}
