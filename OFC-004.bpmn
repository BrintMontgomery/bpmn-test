<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OFC004" targetNamespace="http://oklahoma.gov/odmhsas/ofc/bpmn" exporter="generate_bpmn_ofc004.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_OFC004">
    <bpmn:participant id="Participant_OFCCaseManagement" name="Oklahoma Forensic Center — Case Manager Intakes Consumer" processRef="Process_OFC004"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_OFC004" name="OFC-004 — Case Manager Intakes Consumer" isExecutable="false">
    <bpmn:documentation>- OFC-004 — Case Manager Intakes Consumer. Oklahoma Forensic Center, Case Management Unit. Version 1.1, 2026-08-11. Standardized case-management admission process to establish emergency and restricted contacts, document the consumer's treatment advocate, verify authorized contacts, and ensure required release documentation is available to staff.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_OFC004">
      <bpmn:lane id="Lane_CM" name="Case Manager">
        <bpmn:flowNodeRef>StartEvent_AdmissionNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeginElopementForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewAdmissionReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchOSCN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProtectiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordRestrictedPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DoNotAuthorizeContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConsumerRequestsRestricted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformConsumerOfRestriction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProtectiveOrderJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainRemainingInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmailElopementForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewTAFormWithConsumer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConsumerAbleToParticipate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostponeActivity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnWhenAble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PeriodicFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactAdvocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScanDocumentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MailCopyToAdvocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdvocateChangeRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessAdvocateChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdvocateChangeJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAdditionalContacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdditionalContactRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteROI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordROIPurpose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactProspectiveContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContactAgrees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformFloorStaffNewContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceROIInChartOptionA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformConsumerDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContactJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmContactSheet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommunicateVerifiedContacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FileApprovedROIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClinicalEventWitnessed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DocumentInAvatar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClinicalEventJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostAdmissionChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessContactChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyROIForChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommunicateChangeToFloorStaff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOngoingIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HandoffTarget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HandoffJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CON" name="Consumer">
        <bpmn:flowNodeRef>Task_ConsumerIdentifiesAdvocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsumerSignsROI</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SW" name="Social Worker">
        <bpmn:flowNodeRef>Task_SWReceivesHandoff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NS" name="Nursing Staff">
        <bpmn:flowNodeRef>Task_NursingCompletesAdmission</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FS" name="Floor Staff">
        <bpmn:flowNodeRef>Task_FloorStaffMaintainsSheet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FSReceivesHandoff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PTA" name="Prospective Treatment Advocate">
        <bpmn:flowNodeRef>Task_AdvocateSignsForm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PC" name="Prospective Contact">
        <bpmn:flowNodeRef>Task_ProspectiveContactResponds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_AdmissionNotification" name="Admission notification email and consumer report received">
      <bpmn:documentation>- Receive the admission notification email and associated consumer report.</bpmn:documentation>
      <bpmn:outgoing>Flow_StartEvent_AdmissionNotification__Task_BeginElopementForm</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_StartEvent_AdmissionNotification"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_BeginElopementForm" name="Begin the Elopement Form">
      <bpmn:documentation>- Open and begin the Elopement Form with available information.</bpmn:documentation>
      <bpmn:incoming>Flow_StartEvent_AdmissionNotification__Task_BeginElopementForm</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_BeginElopementForm__Task_ReviewAdmissionReport</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewAdmissionReport" name="Review the admission report for contacts, attorneys, sheriff information, and victims">
      <bpmn:documentation>- Search the admission report for emergency contacts, county contacts, attorneys, sheriff information, and victim information.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_BeginElopementForm__Task_ReviewAdmissionReport</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ReviewAdmissionReport__Task_SearchOSCN</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SearchOSCN" name="Search OSCN for protective orders">
      <bpmn:documentation>- Search the Oklahoma State Courts Network (OSCN) for active protective orders.
- Record applicable contact restrictions on the Elopement Form.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_ReviewAdmissionReport__Task_SearchOSCN</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SearchOSCN__Gateway_ProtectiveOrder</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ProtectiveOrder" name="Protective order restricts contact?" default="Flow_Gateway_ProtectiveOrder__Gateway_ProtectiveOrderJoin">
      <bpmn:documentation>- Option B — a protective order involves a proposed or existing contact.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_SearchOSCN__Gateway_ProtectiveOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ProtectiveOrder__Gateway_ProtectiveOrderJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_ProtectiveOrder__Task_RecordRestrictedPerson</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RecordRestrictedPerson" name="Record the restricted person on the Elopement Form">
      <bpmn:incoming>Flow_Gateway_ProtectiveOrder__Task_RecordRestrictedPerson</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RecordRestrictedPerson__Task_DoNotAuthorizeContact</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_DoNotAuthorizeContact" name="Do not authorize contact with the restricted person">
      <bpmn:incoming>Flow_Task_RecordRestrictedPerson__Task_DoNotAuthorizeContact</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_DoNotAuthorizeContact__Gateway_ConsumerRequestsRestricted</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_ConsumerRequestsRestricted" name="Consumer requests prohibited contact?" default="Flow_Gateway_ConsumerRequestsRestricted__Gateway_ProtectiveOrderJoin">
      <bpmn:incoming>Flow_Task_DoNotAuthorizeContact__Gateway_ConsumerRequestsRestricted</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ConsumerRequestsRestricted__Gateway_ProtectiveOrderJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_ConsumerRequestsRestricted__Task_InformConsumerOfRestriction</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_InformConsumerOfRestriction" name="Inform the Consumer of the restriction">
      <bpmn:incoming>Flow_Gateway_ConsumerRequestsRestricted__Task_InformConsumerOfRestriction</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_InformConsumerOfRestriction__Gateway_ProtectiveOrderJoin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_ProtectiveOrderJoin">
      <bpmn:incoming>Flow_Gateway_ProtectiveOrder__Gateway_ProtectiveOrderJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_ConsumerRequestsRestricted__Gateway_ProtectiveOrderJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_InformConsumerOfRestriction__Gateway_ProtectiveOrderJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ProtectiveOrderJoin__Task_ObtainRemainingInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ObtainRemainingInfo" name="Obtain remaining consumer information after arrival and complete the Elopement Form">
      <bpmn:incoming>Flow_Gateway_ProtectiveOrderJoin__Task_ObtainRemainingInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ObtainRemainingInfo__Task_EmailElopementForm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_EmailElopementForm" name="Email the completed Elopement Form to admissions staff">
      <bpmn:incoming>Flow_Task_ObtainRemainingInfo__Task_EmailElopementForm</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_EmailElopementForm__Task_ReviewTAFormWithConsumer</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_ReviewTAFormWithConsumer" name="Review the Treatment Advocate Form with the Consumer">
      <bpmn:incoming>Flow_Task_EmailElopementForm__Task_ReviewTAFormWithConsumer</bpmn:incoming>
      <bpmn:incoming>Flow_Task_PeriodicFollowUp__Task_ReviewTAFormWithConsumer</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ReviewTAFormWithConsumer__Gateway_ConsumerAbleToParticipate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ConsumerAbleToParticipate" name="Consumer able to participate?" default="Flow_Gateway_ConsumerAbleToParticipate__Task_ConsumerIdentifiesAdvocate">
      <bpmn:documentation>- Option C — the Consumer is too agitated, delusional, or unable to participate effectively.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_ReviewTAFormWithConsumer__Gateway_ConsumerAbleToParticipate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ConsumerAbleToParticipate__Task_ConsumerIdentifiesAdvocate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_ConsumerAbleToParticipate__Task_PostponeActivity</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_PostponeActivity" name="Postpone the activity">
      <bpmn:incoming>Flow_Gateway_ConsumerAbleToParticipate__Task_PostponeActivity</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PostponeActivity__Task_ReturnWhenAble</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_ReturnWhenAble" name="Return when the Consumer is able to participate">
      <bpmn:incoming>Flow_Task_PostponeActivity__Task_ReturnWhenAble</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ReturnWhenAble__Task_PeriodicFollowUp</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_PeriodicFollowUp" name="Continue periodic follow-up during the week">
      <bpmn:incoming>Flow_Task_ReturnWhenAble__Task_PeriodicFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PeriodicFollowUp__Task_ReviewTAFormWithConsumer</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_ConsumerIdentifiesAdvocate" name="Identify a prospective external Treatment Advocate">
      <bpmn:incoming>Flow_Gateway_ConsumerAbleToParticipate__Task_ConsumerIdentifiesAdvocate</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ConsumerIdentifiesAdvocate__Task_ContactAdvocate</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="Task_ContactAdvocate" name="Contact the Prospective Treatment Advocate">
      <bpmn:documentation>- Obtain confirmation that the person is willing to serve in that role.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_ConsumerIdentifiesAdvocate__Task_ContactAdvocate</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ContactAdvocate__Task_AdvocateSignsForm</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="Task_AdvocateSignsForm" name="Sign the Treatment Advocate Form">
      <bpmn:incoming>Flow_Task_ContactAdvocate__Task_AdvocateSignsForm</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AdvocateSignsForm__Task_ConsumerSignsROI</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_ConsumerSignsROI" name="Sign the associated Release of Information authorization">
      <bpmn:incoming>Flow_Task_AdvocateSignsForm__Task_ConsumerSignsROI</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ConsumerSignsROI__Task_ScanDocumentation</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_ScanDocumentation" name="Scan a copy of the completed treatment-advocate documentation">
      <bpmn:incoming>Flow_Task_ConsumerSignsROI__Task_ScanDocumentation</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ScanDocumentation__Task_MailCopyToAdvocate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_MailCopyToAdvocate" name="Mail a copy to the Treatment Advocate">
      <bpmn:incoming>Flow_Task_ScanDocumentation__Task_MailCopyToAdvocate</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_MailCopyToAdvocate__Gateway_AdvocateChangeRequested</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_AdvocateChangeRequested" name="Consumer requests a different Treatment Advocate?" default="Flow_Gateway_AdvocateChangeRequested__Gateway_AdvocateChangeJoin">
      <bpmn:documentation>- Option D — the Consumer requests a different Treatment Advocate after the initial designation.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_MailCopyToAdvocate__Gateway_AdvocateChangeRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_AdvocateChangeRequested__Gateway_AdvocateChangeJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_AdvocateChangeRequested__Task_ProcessAdvocateChange</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ProcessAdvocateChange" name="Process the new Treatment Advocate designation">
      <bpmn:incoming>Flow_Gateway_AdvocateChangeRequested__Task_ProcessAdvocateChange</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ProcessAdvocateChange__Gateway_AdvocateChangeJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AdvocateChangeJoin">
      <bpmn:incoming>Flow_Gateway_AdvocateChangeRequested__Gateway_AdvocateChangeJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_ProcessAdvocateChange__Gateway_AdvocateChangeJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_AdvocateChangeJoin__Task_NursingCompletesAdmission</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_NursingCompletesAdmission" name="Nursing Staff completes the nursing portion of the admission">
      <bpmn:incoming>Flow_Gateway_AdvocateChangeJoin__Task_NursingCompletesAdmission</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_NursingCompletesAdmission__Task_CheckAdditionalContacts</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_CheckAdditionalContacts" name="Check with the Social Worker and Consumer for additional persons">
      <bpmn:incoming>Flow_Task_NursingCompletesAdmission__Task_CheckAdditionalContacts</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CheckAdditionalContacts__Gateway_AdditionalContactRequested</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AdditionalContactRequested" name="Consumer requests an additional contact?" default="Flow_Gateway_AdditionalContactRequested__Gateway_ContactJoin">
      <bpmn:documentation>- Option A — the Consumer requests that another person be added to the unit contact sheet.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_CheckAdditionalContacts__Gateway_AdditionalContactRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_AdditionalContactRequested__Gateway_ContactJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_AdditionalContactRequested__Task_CompleteROI</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CompleteROI" name="Complete an ROI with the Consumer">
      <bpmn:incoming>Flow_Gateway_AdditionalContactRequested__Task_CompleteROI</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CompleteROI__Task_RecordROIPurpose</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RecordROIPurpose" name="Record authorized purposes or information categories on the ROI">
      <bpmn:documentation>- Include applicable contact purposes such as visit, telephone call, or televisit.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_CompleteROI__Task_RecordROIPurpose</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RecordROIPurpose__Task_ContactProspectiveContact</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_ContactProspectiveContact" name="Contact the Prospective Contact">
      <bpmn:documentation>- Ask whether the person agrees to receive contact from the Consumer.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_RecordROIPurpose__Task_ContactProspectiveContact</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ContactProspectiveContact__Task_ProspectiveContactResponds</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="Task_ProspectiveContactResponds" name="Respond with agreement or decline">
      <bpmn:incoming>Flow_Task_ContactProspectiveContact__Task_ProspectiveContactResponds</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ProspectiveContactResponds__Gateway_ContactAgrees</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_ContactAgrees" name="Prospective Contact agrees?" default="Flow_Gateway_ContactAgrees__Task_InformFloorStaffNewContact">
      <bpmn:incoming>Flow_Task_ProspectiveContactResponds__Gateway_ContactAgrees</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ContactAgrees__Task_InformFloorStaffNewContact</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_ContactAgrees__Task_InformConsumerDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_InformFloorStaffNewContact" name="Inform Floor Staff that the contact may be added to the unit contact sheet">
      <bpmn:incoming>Flow_Gateway_ContactAgrees__Task_InformFloorStaffNewContact</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_InformFloorStaffNewContact__Task_PlaceROIInChartOptionA</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="Task_PlaceROIInChartOptionA" name="Place the approved ROI in the consumer chart">
      <bpmn:incoming>Flow_Task_InformFloorStaffNewContact__Task_PlaceROIInChartOptionA</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PlaceROIInChartOptionA__Gateway_ContactJoin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_InformConsumerDeclined" name="Inform the Consumer and do not authorize the contact">
      <bpmn:incoming>Flow_Gateway_ContactAgrees__Task_InformConsumerDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_InformConsumerDeclined__Gateway_ContactJoin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_ContactJoin">
      <bpmn:incoming>Flow_Gateway_AdditionalContactRequested__Gateway_ContactJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_PlaceROIInChartOptionA__Gateway_ContactJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_InformConsumerDeclined__Gateway_ContactJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ContactJoin__Task_ConfirmContactSheet</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ConfirmContactSheet" name="Confirm that the unit contact sheet reflects approved contacts">
      <bpmn:incoming>Flow_Gateway_ContactJoin__Task_ConfirmContactSheet</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ConfirmContactSheet__Task_CommunicateVerifiedContacts</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_CommunicateVerifiedContacts" name="Communicate verified contact information to Floor Staff">
      <bpmn:incoming>Flow_Task_ConfirmContactSheet__Task_CommunicateVerifiedContacts</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CommunicateVerifiedContacts__Task_FloorStaffMaintainsSheet</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="Task_FloorStaffMaintainsSheet" name="Maintain the operational unit contact sheet">
      <bpmn:incoming>Flow_Task_CommunicateVerifiedContacts__Task_FloorStaffMaintainsSheet</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_FloorStaffMaintainsSheet__Task_FileApprovedROIs</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_FileApprovedROIs" name="Ensure each approved ROI is placed in the consumer chart">
      <bpmn:incoming>Flow_Task_FloorStaffMaintainsSheet__Task_FileApprovedROIs</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_FileApprovedROIs__Gateway_ClinicalEventWitnessed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ClinicalEventWitnessed" name="Event requiring clinical documentation witnessed?" default="Flow_Gateway_ClinicalEventWitnessed__Gateway_ClinicalEventJoin">
      <bpmn:documentation>- Option F — the Case Manager personally witnesses an event that requires documentation.</bpmn:documentation>
      <bpmn:incoming>Flow_Task_FileApprovedROIs__Gateway_ClinicalEventWitnessed</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ClinicalEventWitnessed__Gateway_ClinicalEventJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_ClinicalEventWitnessed__Task_DocumentInAvatar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DocumentInAvatar" name="Document the event in Avatar">
      <bpmn:incoming>Flow_Gateway_ClinicalEventWitnessed__Task_DocumentInAvatar</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_DocumentInAvatar__Gateway_ClinicalEventJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ClinicalEventJoin">
      <bpmn:incoming>Flow_Gateway_ClinicalEventWitnessed__Gateway_ClinicalEventJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_DocumentInAvatar__Gateway_ClinicalEventJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ClinicalEventJoin__Gateway_PostAdmissionChange</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PostAdmissionChange" name="Contact-list change requested after admission?" default="Flow_Gateway_PostAdmissionChange__Task_DeliverOngoingIssues">
      <bpmn:documentation>- Option E — the Consumer requests that a person be added to or removed from the contact sheet after the initial admission process.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_ClinicalEventJoin__Gateway_PostAdmissionChange</bpmn:incoming>
      <bpmn:incoming>Flow_Task_CommunicateChangeToFloorStaff__Gateway_PostAdmissionChange</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_PostAdmissionChange__Task_DeliverOngoingIssues</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_PostAdmissionChange__Task_ProcessContactChange</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ProcessContactChange" name="Process the requested change">
      <bpmn:incoming>Flow_Gateway_PostAdmissionChange__Task_ProcessContactChange</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ProcessContactChange__Task_VerifyROIForChange</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerifyROIForChange" name="Complete and verify an ROI when required">
      <bpmn:incoming>Flow_Task_ProcessContactChange__Task_VerifyROIForChange</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_VerifyROIForChange__Task_CommunicateChangeToFloorStaff</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_CommunicateChangeToFloorStaff" name="Communicate the approved change to Floor Staff">
      <bpmn:incoming>Flow_Task_VerifyROIForChange__Task_CommunicateChangeToFloorStaff</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CommunicateChangeToFloorStaff__Gateway_PostAdmissionChange</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_DeliverOngoingIssues" name="Complete the case-management admission workflow">
      <bpmn:documentation>- Deliver ongoing contact, behavioral, or consumer-support issues to the Social Worker or Floor Staff as appropriate.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_PostAdmissionChange__Task_DeliverOngoingIssues</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_DeliverOngoingIssues__Gateway_HandoffTarget</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HandoffTarget" name="Handoff to Floor Staff or Social Worker?" default="Flow_Gateway_HandoffTarget__Task_FSReceivesHandoff">
      <bpmn:incoming>Flow_Task_DeliverOngoingIssues__Gateway_HandoffTarget</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_HandoffTarget__Task_FSReceivesHandoff</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_HandoffTarget__Task_SWReceivesHandoff</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_FSReceivesHandoff" name="Receive handoff of ongoing issues">
      <bpmn:incoming>Flow_Gateway_HandoffTarget__Task_FSReceivesHandoff</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_FSReceivesHandoff__Gateway_HandoffJoin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_SWReceivesHandoff" name="Receive handoff of ongoing issues">
      <bpmn:incoming>Flow_Gateway_HandoffTarget__Task_SWReceivesHandoff</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SWReceivesHandoff__Gateway_HandoffJoin</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_HandoffJoin">
      <bpmn:incoming>Flow_Task_FSReceivesHandoff__Gateway_HandoffJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_SWReceivesHandoff__Gateway_HandoffJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_HandoffJoin__EndEvent_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Complete" name="Case-management admission workflow complete">
      <bpmn:documentation>- The consumer's elopement information, protective-order restrictions, treatment advocate status, and approved external contacts are documented and communicated. Required ROI documentation is placed in the chart. Delayed or unresolved admission activity is tracked and handed off to Social Worker or Floor Staff.</bpmn:documentation>
      <bpmn:incoming>Flow_Gateway_HandoffJoin__EndEvent_Complete</bpmn:incoming>
    </bpmn:endEvent>
